# ==============================================================================
# MCP 远程服务与 Web AI 连接配置模板 (config.env)
# 复制本文件为 config.env 并填入实际参数即可
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务器与 Python 环境设置
# ------------------------------------------------------------------------------
# Python 解释器路径 (建议使用 conda 虚拟环境，需 Python 3.10+)
PYTHON_EXEC="/path/to/your/conda_or_venv/bin/python"

# 远程工作区根目录 (AI 可以访问和操作的目录)
WORKSPACE_DIR="/path/to/your/workspace"

# 本地监听端口 (如 28766, 28767, 28768 等)
LOCAL_PORT="28767"

# 本地监听地址 (通常为 127.0.0.1，通过隧道暴露公网)
LOCAL_HOST="127.0.0.1"

# ------------------------------------------------------------------------------
# 2. 公网穿透隧道配置 (DevTunnel / Cloudflare Tunnel / FRP 等)
# ------------------------------------------------------------------------------
# 隧道分配的公网基础 URL (末尾不要加斜杠，例如: https://<YOUR_TUNNEL_NAME>-<PORT>.<REGION>.devtunnels.ms)
PUBLIC_BASE_URL="https://<YOUR_PUBLIC_TUNNEL_URL>"

# 允许跨域调用的前端 Origin (逗号分隔，保持默认即可支持 ChatGPT 与 Gemini)
ALLOWED_ORIGINS="https://gemini.google.com,https://chatgpt.com,https://chat.openai.com,https://<YOUR_PUBLIC_TUNNEL_URL>"

# ------------------------------------------------------------------------------
# 3. OAuth 2.0 鉴权安全配置 (供 ChatGPT 和 Gemini 绑定时使用)
# ------------------------------------------------------------------------------
# 客户端 ID (可自定义随机字符串或保留默认)
OAUTH_CLIENT_ID="<YOUR_CLIENT_ID_OR_RANDOM_STRING>"

# 客户端密钥 (可自定义高强度随机字符串或保留默认)
OAUTH_CLIENT_SECRET="<YOUR_CLIENT_SECRET_OR_RANDOM_STRING>"

# 用户授权登录密码 (你在网页端授权弹窗中输入的密码，必须高强度防爆破)
OAUTH_USER_PASSWORD="<YOUR_SECURE_AUTH_PASSWORD>"

# Token 签名密钥 (建议 64 位 16 进制随机字符串)
OAUTH_TOKEN_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Token 有效期 (秒，默认 315360000 即 10 年长效授权)
OAUTH_TOKEN_TTL="315360000"

# 允许的 OAuth 回调 URI (支持 Google 与 OpenAI 官方回调地址，<YOUR_PUBLIC_TUNNEL_TAG> 需与你的隧道名称一致)
OAUTH_REDIRECT_URIS="https://oauth-redirect.googleusercontent.com/r/<YOUR_GAIA_OR_APP_TAG>,https://gemini.google.com/auth/callback,https://gemini.google.com/oauth/callback,https://gemini.google.com/callback,https://gemini.google.com,http://127.0.0.1/callback,https://chatgpt.com,https://chat.openai.com"

# ------------------------------------------------------------------------------
# 4. MCP 工具与执行权限设置
# ------------------------------------------------------------------------------
# 对外暴露的核心工具 (逗号分隔，可包含: list_dir,exec_command,read_file,apply_patch)
EXPOSED_TOOLS="list_dir,exec_command,read_file,apply_patch"

# 权限模式 (危险模式 dangerous: 允许全自动化静默执行，不弹窗打断)
PERMISSION_MODE="dangerous"

# 日志输出文件路径
LOG_FILE="./mcp_service.log"
